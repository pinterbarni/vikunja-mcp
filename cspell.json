{
  "version": "0.2",
  "language": "en",
  "files": [
    "src/**",
    "tests/**",
    "*.md",
    "*.toml",
    "*.json",
    "*.yml",
    "*.yaml"
  ],
  "ignorePaths": [
    ".venv/**",
    "uv.lock",
    "node_modules/**",
    ".git/**",
    "*.lock"
  ],
  "ignoreRegExpList": ["/https?:\\/\\/\\S+/", "/[0-9a-f]{7,40}/"],
  "words": ["pycache", "venv", "vikunja", "pytest", "testpaths"]
}
