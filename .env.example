# Base URL of Vikunja instance where /api/v1 is optional.
VIKUNJA_URL=#todo-https://vikunja.example.com

# API token created in Vikunja under Settings, API tokens.
VIKUNJA_API_TOKEN=#todo-change_me

# Optional: seconds to wait for Vikunja before giving up (default example 10)
# VIKUNJA_TIMEOUT_SECONDS=10

# Optional: DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO)
# LOG_LEVEL=INFO

# Hosts accepted on /mcp, as a JSON list. Add public domain(s) when deploying.
# ALLOWED_HOSTS=["mcp.example.com"]
